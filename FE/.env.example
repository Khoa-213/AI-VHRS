# Google Web client id, the same one as GOOGLE_CLIENT on the backend. Without it the Google button is hidden.
# Add http://localhost:5173 (and the deployed origin) to "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Firebase phone sign-in (Google sends the SMS codes): the web app's firebaseConfig of the same project as
# FIREBASE_PROJECT_ID on the backend (Firebase console > Project settings > Your apps). Public values. All four are
# needed; without them the phone screens use the backend's own SMS code flow (MOCK unless an SMS provider is set).
# localhost is not accepted by Firebase phone auth: test on the deployed domain, or with "Phone numbers for testing".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
