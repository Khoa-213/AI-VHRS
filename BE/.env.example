# Copy to .env (git-ignored). Use the Supabase *session pooler* string (port 5432, IPv4).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-long-random
CORS_ORIGINS=["http://localhost:5173"]
# Optional: regex for Vercel preview URLs
# CORS_ORIGIN_REGEX=https://ai-vhrs-[a-z0-9-]+\.vercel\.app
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=true
# Set true only when the API is reachable solely through your own reverse proxy (X-Forwarded-For / -Proto).
TRUST_PROXY_HEADERS=false

# Supabase Storage for customer uploads (Phase 1). Server-side only; never expose the service key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key>
# STORAGE_BUCKET=order-inputs

# Google sign-in (optional): OAuth Web client id(s) from Google Cloud Console, comma separated
# GOOGLE_CLIENT=<id>.apps.googleusercontent.com

# ---- Online payments (VNPay, MoMo). mock = simulated (default); sandbox = gateway test environments; live = REAL MONEY.
# PAYMENT_MODE=mock
# PUBLIC_BASE_URL=https://<your-api>.onrender.com
# PAYMENT_RETURN_URL=https://ai-vhrs.vercel.app/payment/result   (BE adds ?order_id=<id>)
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# payOS (VietQR bank transfer into your own account). No test environment: every payment is a REAL transfer. Available
# whenever the three keys are set, whatever PAYMENT_MODE is. Register the webhook once: scripts/register_payos_webhook.py
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=

# ---- Carrier: GHN only. mock = simulated (default); sandbox = GHN's test environment; live = real waybills.
# In sandbox/live GHN's master data also feeds the address pickers (GET /locations/...). The pick-up address is the shop's own
# address registered with GHN. In the Developer Portal set the webhook to  {PUBLIC_BASE_URL}/api/v1/webhooks/shipments/GHN?key=<secret>
# (or send the secret in a custom header X-Webhook-Secret).
# CARRIER_MODE=mock
# CARRIER_WEBHOOK_SECRET=<long random string used in the callback address>
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api     # production: https://online-gateway.ghn.vn/shiip/public-api

# ---- SMS for phone OTP (FR-53). mock = nothing is sent (default).
# speedsms = SpeedSMS.vn, personal account (no business licence). NO sandbox: every OTP is a REAL, paid SMS.
# Access token: connect.speedsms.vn -> Settings -> Profile. SPEEDSMS_SMS_TYPE 4 = SpeedSMS's default Brandname (Verify / Notify),
# 2 = random number, 3 = own Brandname and 5 = their Android app (both need SPEEDSMS_SENDER).
# SMS_MODE=speedsms
# SPEEDSMS_ACCESS_TOKEN=
# SPEEDSMS_SMS_TYPE=4
# SPEEDSMS_SENDER=
# esms = eSMS.vn, Brandname CSKH (SmsType 2).
# The Brandname is registered with the carriers through eSMS (needs a business licence); the OTP texts in
# app/services/phone_otp.py (VERIFY_SMS, RESET_SMS) must match the templates eSMS approved for it.
# ESMS_SANDBOX=true: eSMS answers but delivers and charges nothing. false = real SMS, only on the project owner's say.
# SMS_MODE=esms
# ESMS_API_KEY=
# ESMS_SECRET_KEY=
# ESMS_BRANDNAME=
# ESMS_SANDBOX=true

# ---- E-mail for alerts and password reset. Without SMTP_HOST nothing is sent (console log only).
# Gmail example: smtp.gmail.com, port 587, an "app password" (never the account password).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Set true on any station that drives a real robot: a simulation result is only accepted after the server re-validates it.
# MOTION_VALIDATION_REQUIRED=false
