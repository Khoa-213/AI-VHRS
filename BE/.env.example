# Copy to .env (git-ignored). Use the Supabase *session pooler* string (port 5432, IPv4).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-long-random
CORS_ORIGINS=["http://localhost:5173"]
# Optional: regex for Vercel preview URLs
# CORS_ORIGIN_REGEX=https://ai-vhrs-[a-z0-9-]+\.vercel\.app
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=true
# Set true only when the API is reachable solely through your own reverse proxy (X-Forwarded-For / -Proto).
TRUST_PROXY_HEADERS=false

# Supabase Storage for customer uploads (Phase 1). Server-side only; never expose the service key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key>
# STORAGE_BUCKET=order-inputs

# Google sign-in (optional): OAuth Web client id(s) from Google Cloud Console, comma separated
# GOOGLE_CLIENT=<id>.apps.googleusercontent.com

# ---- Online payments (VNPay, MoMo). mock = simulated (default); sandbox = gateway test environments; live = REAL MONEY.
# PAYMENT_MODE=mock
# PUBLIC_BASE_URL=https://<your-api>.onrender.com
# PAYMENT_RETURN_URL=https://ai-vhrs.vercel.app/payment/result   (BE adds ?order_id=<id>)
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# payOS (VietQR bank transfer into your own account). No test environment: every payment is a REAL transfer. Available
# whenever the three keys are set, whatever PAYMENT_MODE is. Register the webhook once: scripts/register_payos_webhook.py
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=

# ---- Carriers (GHN, GHTK). mock = simulated (default); sandbox = carrier test environments; live = real waybills.
# CARRIER_MODE=mock
# CARRIER_WEBHOOK_SECRET=<long random string used in the callback address>
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_FROM_DISTRICT_ID=
# GHN_FROM_WARD_CODE=
# GHTK_TOKEN=
# GHTK_CLIENT_SOURCE=
# WORKSHOP_PHONE=
# WORKSHOP_ADDRESS=
# WORKSHOP_PROVINCE=
# WORKSHOP_DISTRICT=
# WORKSHOP_WARD=


# ---- E-mail for alerts and password reset. Without SMTP_HOST nothing is sent (console log only).
# Gmail example: smtp.gmail.com, port 587, an "app password" (never the account password).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Set true on any station that drives a real robot: a simulation result is only accepted after the server re-validates it.
# MOTION_VALIDATION_REQUIRED=false
